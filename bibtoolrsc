expand.macros=on
# Preserve citation keys from the existing bibliography.
key.generation=off
key.expand.macros=on
key.base=lower
key.number.separator={}
key.format=
{
%s(bibkey)
#
%0s(@book)
{ %n(author) : # %n(editor)_ed: # --no-author-- :}
{%4d(year) # }
#
%0s(@article)
{ %n(author):#}
{%4d(year)}
#
%0s(@proceedings)
{%n(editor)}
{%4d(year) # }
#
%0s(@inproceedings)
{%n(author):#}
{%4d(year) #}
#
%3s($type)-
{%-2.4n(author):
# %-6.1W(title).}
{%4d(year) #}
#
%3s($type)-
%4d(year)
#
???
}

sort.order={*=author # title}
sort.order={*=title # year}
sort.order={book=author # editor # title # series # volume # publisher # address # year }
sort.order={article=author # title # journal # volume # pages # year }
sort.format={%n(author) # %n(editor)}
sort={on}


rewrite.rule={"^\"\([^#]*\)\"$" "{\1}"}
rewrite.rule { month "^\({January}\|{Jan}\|jan\)$" "{1}" }
rewrite.rule { month "^\({February}\|{Feb}\|feb\)$" "{2}" }
rewrite.rule { month "^\({March}\|{Mar}\|mar\)$" "{3}" }
rewrite.rule { month "^\({April}\|{Apr}\|apr\)$" "{4}" }
rewrite.rule { month "^\({May}\|may\)$" "{5}" }
rewrite.rule { month "^\({June}\|{Jun}\|jun\)$" "{6}" }
rewrite.rule { month "^\({July}\|{Jul}\|jul\)$" "{7}" }
rewrite.rule { month "^\({August}\|{Aug}\|aug\)$" "{8}" }
rewrite.rule { month "^\({September}\|{Sep}\|sep\|{Sept}\|sept\)$" "{9}" }
rewrite.rule { month "^\({October}\|{Oct}\|oct\)$" "{10}" }
rewrite.rule { month "^\({November}\|{Nov}\|nov\)$" "{11}" }
rewrite.rule { month "^\({December}\|{Dec}\|dec\)$" "{12}" }
new.entry.type = {Online}

